{
  "name": "regumove",
  "version": "0.1.0",
  "description": "Bare-bones static site template for Regumove.",
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:pages": "node -e \"const r=require('node:child_process').spawnSync('astro',['build'],{stdio:'inherit',shell:true,env:{...process.env,GITHUB_PAGES:'true'}});process.exit(r.status??1)\"",
    "preview": "astro preview",
    "preview:cf": "astro build && wrangler dev --config wrangler.jsonc",
    "deploy": "astro build && wrangler deploy --config wrangler.jsonc --no-autoconfig",
    "astro": "astro"
  },
  "license": "ISC",
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@tailwindcss/vite": "4.3.2",
    "astro": "7.0.9",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
