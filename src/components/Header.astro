---
import logo from "../assets/brand/logo.svg";
import wordmark from "../assets/brand/wordmark.svg";
import { nav } from "../data/nav";
import Button from "./Button.astro";
import { withBase } from "../lib/url";

// Anchors are same-page on the home page; elsewhere (e.g. /privacy) they point back to it.
const homePath = withBase("/");
const isHome = Astro.url.pathname === homePath || `${Astro.url.pathname}/` === homePath;
const home = isHome ? "" : homePath;
---

<header id="site-header">
  <div class="site-container site-container-wide flex items-center justify-between gap-4 h-[4.25rem] md:h-[4.75rem]">
    <a href={home || "#home"} class="logo-link shrink-0" aria-label="ReguMove">
      <!-- Below 768px the wordmark stands alone, so the puzzle symbol appears once (on the menu button).
           The link's aria-label is the accessible name; both images are decorative. -->
      <img
        src={wordmark.src}
        width={wordmark.width}
        height={wordmark.height}
        alt=""
        loading="eager"
        decoding="async"
        class="logo logo-wordmark"
      />
      <img
        src={logo.src}
        width={logo.width}
        height={logo.height}
        alt=""
        loading="eager"
        decoding="async"
        class="logo logo-full"
      />
    </a>
    <div class="flex items-center justify-end gap-6 md:gap-8">
      <nav class="hidden md:block" aria-label="Page">
        <ul class="flex items-center gap-8">
          {
            nav.map((item) => (
              <li>
                {"cta" in item ? (
                  <Button href={`${home}${item.href}`} class="nav-cta">
                    {item.label}
                  </Button>
                ) : (
                  <a href={`${home}${item.href}`} class="nav-link">
                    {item.label}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
      <button
        id="nav-toggle"
        type="button"
        class="menu-button"
        aria-expanded="false"
        aria-controls="nav-panel"
        aria-label="Menu"
      >
        <!-- The three-piece puzzle symbol from logo.svg, in its original orientation. -->
        <svg class="menu-symbol" viewBox="6 6 308 246" aria-hidden="true" focusable="false"><g transform="translate(3.5 4) scale(.539)"><path fill="#5a5b5c" d="M69.0 12.0 C58.8 14.4 55.7 15.5 47.5 19.5 C27.9 29.0 15.4 46.6 11.1 70.4 C10.4 74.4 10.0 104.3 10.0 159.0 C10.0 241.7 10.0 241.7 12.6 244.4 C16.5 248.2 25.0 248.1 30.8 244.2 C35.0 241.4 48.3 229.4 67.5 211.0 C91.5 188.1 103.4 177.4 106.4 176.1 C112.6 173.4 117.2 175.8 128.5 187.4 C143.0 202.2 147.9 204.5 165.5 204.5 C178.0 204.5 178.7 204.4 185.2 201.3 C194.1 197.1 201.1 190.5 205.3 182.1 C208.4 176.1 209.1 173.9 210.4 166.3 C210.6 165.1 210.4 160.6 209.9 156.4 C208.3 143.5 202.7 133.4 189.1 119.0 C183.5 113.0 183.0 112.2 183.0 107.8 C183.0 102.4 185.0 100.2 232.5 54.2 C256.6 30.8 258.0 29.0 257.5 22.4 C256.9 15.8 256.2 14.1 253.0 12.5 C249.8 10.8 76.1 10.4 69.0 12.0 Z"/><path fill="#759c63" d="M351.5 10.2 C326.9 16.1 337.0 7.8 245.7 97.0 C227.3 115.0 226.3 118.3 232.4 140.5 C242.5 177.3 230.9 206.7 200.0 222.4 C185.6 229.7 177.5 231.4 161.6 230.7 C155.0 230.4 147.0 229.4 144.0 228.5 C141.0 227.6 136.9 226.4 135.0 225.8 C128.3 223.8 123.0 223.7 117.2 225.5 C111.3 227.4 110.3 228.2 84.5 253.0 C69.3 267.7 56.6 279.6 51.7 283.8 C41.7 292.3 43.8 308.7 55.5 314.5 C61.2 317.2 61.2 317.2 141.3 317.5 C216.8 317.7 221.7 317.6 225.1 315.9 C229.4 313.8 232.0 310.1 232.0 306.3 C232.0 304.8 232.7 301.0 233.5 298.0 C247.7 244.5 325.2 230.1 362.9 273.9 C370.9 283.3 375.1 291.9 378.1 305.0 C379.4 310.7 381.3 313.6 385.0 315.5 C388.8 317.5 486.1 318.7 492.2 316.8 C504.7 313.1 506.5 303.4 501.5 267.0 C499.5 252.6 499.5 242.9 501.4 239.1 C505.2 231.9 514.3 227.2 521.9 228.5 C530.0 229.8 544.7 223.1 554.4 213.6 C571.1 197.3 571.4 165.9 555.0 149.0 C544.1 137.8 534.3 133.9 515.3 133.1 C494.4 132.2 494.3 131.9 493.7 94.5 C493.2 68.9 493.2 68.3 490.1 57.6 C482.5 31.3 465.5 15.3 440.3 10.4 C431.6 8.8 358.3 8.6 351.5 10.2 Z"/></g><path fill="#c1c2c4" fill-rule="evenodd" d="M 164.9 150.8 C 156.4 151.2 148.5 156 145.2 162.8 C 143.2 166.7 142.8 168.7 142.7 175.7 L 142.6 181 141.6 182.8 C 140 186 138.7 187.3 135.6 188.5 L 133.9 189.1 73 189.3 L 12.1 189.4 11.1 190.1 C 8.6 191.8 8.5 192.4 8.8 209.1 C 9 225.4 11.3 232.4 18.8 239.6 C 22.8 243.5 31.3 248 34.5 248 C 34.8 248 35.6 248.2 36.4 248.4 C 39 249.1 114.7 248.9 116.6 248.2 C 119.5 247.2 120.7 245.5 121 241.6 C 122.3 225 141.9 216.2 156.9 225.4 C 162.9 229.1 166.9 235.7 167.5 242.8 C 167.8 246 169.1 247.7 171.9 248.5 C 173.7 249 250.3 248.7 253.4 248.2 C 266.8 245.8 277.1 235.8 279.1 223.1 C 280 217.4 280 216.7 280 204.7 L 279.9 192.8 279.1 191.7 C 278.6 191 277.9 190.4 276.9 189.9 L 275.4 189.2 238 189.1 L 200.6 189.1 198.8 188.4 C 194 186.5 192.5 183.5 192.3 175.4 C 192.1 163.7 189 158.2 179.7 153.2 C 176 151.1 171.6 150.4 164.9 150.8"/></svg>
      </button>
    </div>
  </div>
  <div id="nav-panel" class="nav-panel" hidden>
    <nav aria-label="Menu">
      <ul class="py-2">
        {
          nav.map((item) => (
            <li>
              <a href={`${home}${item.href}`} class="menu-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
